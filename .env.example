# Aegis-SWE Environment Configuration
# Supported providers: groq, openai, anthropic, ollama
AEGIS_LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Execution Sandbox Configuration (docker or local)
AEGIS_SANDBOX_MODE=local
DOCKER_SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=1024

# MCTS Search Hyperparameters
MCTS_MAX_ITERATIONS=15
MCTS_EXPLORATION_CONSTANT=1.414
MCTS_MAX_DEPTH=6
